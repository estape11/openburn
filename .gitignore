node_modules/

# Build output
dist/
*.tsbuildinfo

# Test artifacts
coverage/
test-results/
playwright-report/

# Environment (real values live outside the tree; see .env.example when it exists)
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.swp
